# WordPress (Headless)
WORDPRESS_GRAPHQL_ENDPOINT=
WORDPRESS_REST_URL=
WORDPRESS_MEDIA_HOSTNAME=
WORDPRESS_USE_MOCK_DATA=true

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=

# Email (Resend) — server-only, never expose via NEXT_PUBLIC_*.
# Sent after a lead is successfully saved to WordPress: one notification to
# LEAD_NOTIFICATION_EMAIL, one confirmation to the lead's own address.
RESEND_API_KEY=
EMAIL_FROM="Target Find Finish <leads@tffdigital.com>"
LEAD_NOTIFICATION_EMAIL="info@tffdigital.com"
