# WordPress (Headless)
WORDPRESS_GRAPHQL_ENDPOINT=
WORDPRESS_REST_URL=
WORDPRESS_MEDIA_HOSTNAME=
WORDPRESS_USE_MOCK_DATA=true

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=

# Email (Resend) — server-only, never expose via NEXT_PUBLIC_*.
# Sent after a lead is successfully saved to WordPress: one notification to
# LEAD_NOTIFICATION_EMAIL, one confirmation to the lead's own address.
RESEND_API_KEY=
EMAIL_FROM="Target Find Finish <leads@tffdigital.com>"
LEAD_NOTIFICATION_EMAIL="info@tffdigital.com"

# WordPress Case Study preview — server-only, never expose via NEXT_PUBLIC_*.
# WORDPRESS_PREVIEW_SECRET: any long random string; must match
#   TFF_HEADLESS_PREVIEW_SECRET set in wp-config.php (see
#   wordpress-plugin/tff-headless-leads/tff-headless-leads.php).
# WORDPRESS_PREVIEW_USERNAME / WORDPRESS_PREVIEW_APP_PASSWORD: a WordPress
#   user able to edit Case Studies, plus an Application Password generated
#   for them at wp-admin → Users → Profile → Application Passwords. Used
#   only server-side to authenticate the draft-preview GraphQL query.
WORDPRESS_PREVIEW_SECRET=
WORDPRESS_PREVIEW_USERNAME=
WORDPRESS_PREVIEW_APP_PASSWORD=
