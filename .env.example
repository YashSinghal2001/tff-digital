# WordPress (Headless)
WORDPRESS_GRAPHQL_ENDPOINT=
WORDPRESS_REST_URL=
WORDPRESS_MEDIA_HOSTNAME=
# Local development only (`next dev`): serve src/lib/mock content instead of
# WordPress. Ignored by production builds (`next build` / `next start`, i.e.
# every Vercel deployment), which always use WordPress and fail loudly when
# it is not configured — mock content can never reach production (ARCH-3).
WORDPRESS_USE_MOCK_DATA=true

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=

# Email (SMTP) — server-only, never expose via NEXT_PUBLIC_*.
# Sent after a lead is successfully saved to WordPress: one notification to
# LEAD_NOTIFICATION_EMAIL, one confirmation to the lead's own address.
# SMTP_PASSWORD: the mailbox password, set only via environment (never commit
# a real value here). Verify connectivity with `npm run email:verify`.
SMTP_HOST=mail.tffdigital.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tffdigital.com
SMTP_PASSWORD=
EMAIL_FROM=info@tffdigital.com
LEAD_NOTIFICATION_EMAIL="info@tffdigital.com"

# WordPress Case Study preview — server-only, never expose via NEXT_PUBLIC_*.
# WORDPRESS_PREVIEW_SECRET: any long random string; must match
#   TFF_HEADLESS_PREVIEW_SECRET set in wp-config.php (see
#   wordpress-plugin/tff-headless-leads/tff-headless-leads.php).
# WORDPRESS_PREVIEW_USERNAME / WORDPRESS_PREVIEW_APP_PASSWORD: a WordPress
#   user able to edit Case Studies, plus an Application Password generated
#   for them at wp-admin → Users → Profile → Application Passwords. Used
#   only server-side to authenticate the draft-preview GraphQL query.
WORDPRESS_PREVIEW_SECRET=
WORDPRESS_PREVIEW_USERNAME=
WORDPRESS_PREVIEW_APP_PASSWORD=

# WordPress → Next.js revalidation webhook — server-only, never expose via
# NEXT_PUBLIC_*. WORDPRESS_REVALIDATE_SECRET: any long random string; must
# match TFF_HEADLESS_REVALIDATE_SECRET set in wp-config.php (see
# wordpress-plugin/tff-headless-leads/tff-headless-leads.php). The plugin
# POSTs to /api/revalidate on publish/update/unpublish/trash/delete so the
# cached pages refresh at once instead of at the next 30s ISR window
# (audit CACHE-1). Leave unset to disable the endpoint (time-based ISR only).
WORDPRESS_REVALIDATE_SECRET=
